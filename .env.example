# --- Site ---
# Set this in Vercel too. Without it, canonical URLs, Open Graph tags and the
# sitemap all point at localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (resend.com -> API Keys) ---
# All three are optional: with none of them the contact form still validates
# and records the enquiry, it just cannot send the notification email.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
CONTACT_INBOX_EMAIL=you@example.com
